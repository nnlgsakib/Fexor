# Written automatically by "Start Server". Only edit by hand for advanced setups.

# --- Internet mode (HTTPS) ---
FEXOR_CADDYFILE=Caddyfile
FEXOR_DOMAIN=attendance.example.com
# Email for Let's Encrypt certificate notices.
FEXOR_TLS=admin@example.com
FEXOR_SECURE_COOKIES=true
FEXOR_PUBLIC_URL=https://attendance.example.com

# --- Office network mode (plain HTTP) instead: ---
# FEXOR_CADDYFILE=Caddyfile.http
# FEXOR_SECURE_COOKIES=false
# FEXOR_PUBLIC_URL=http://192.168.1.20

# Long random database password.
POSTGRES_PASSWORD=change-me
# Encryption key for faces and secrets (32 random bytes, base64). Back it up: without it,
# stored face data cannot be read.
FEXOR_DATA_KEY=
