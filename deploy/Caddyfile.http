# Plain HTTP on port 80: office network mode.
# No trusted_proxies here: on an office network anyone could send a fake X-Forwarded-For
# and dodge the per-address login limits. Caddy passes on the real client address.
:80 {
	encode zstd gzip
	request_body {
		max_size 60MB
	}
	reverse_proxy server:8000
}
