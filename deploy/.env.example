# Domain or LAN host name the admin panel and kiosks will use, e.g. attendance.example.com
FEXOR_DOMAIN=attendance.example.com
# Public domain: your email (used by Let's Encrypt for certificate notices).
# LAN-only install without a public domain: internal
FEXOR_TLS=admin@example.com
# Long random database password.
POSTGRES_PASSWORD=change-me
# Encryption key for faces and secrets. Generate once with:
#   docker run --rm fexor-server:latest fexor-server gen-key
# Back it up somewhere safe: without it, stored face data cannot be read.
FEXOR_DATA_KEY=
